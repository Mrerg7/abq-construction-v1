---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page not found | ABQ.Construction"
  description="The page you requested is not available. Return to ABQ.Construction for domain acquisition details."
  canonical="https://abq.construction/404"
  noIndex={true}
>
  <Header />

  <main class="flex-1">
    <section class="section-padding bg-white">
      <div class="container-narrow max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-rust-600">404</p>
        <h1 class="mt-3 font-display text-4xl font-semibold uppercase tracking-wide text-steel-950 sm:text-5xl">
          Page not found
        </h1>
        <p class="mt-4 text-lg text-steel-600">
          That URL is not part of this site. The homepage and domain insights are still available.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="/" class="btn-primary">Back to homepage</a>
          <a href="/insights/" class="btn-secondary">Browse insights</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
