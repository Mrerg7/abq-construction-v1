---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const insights = await getCollection('insights', ({ data }) => !data.draft);
  return insights.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, pubDate, tags } = entry.data;
const canonical = `https://abq.construction/insights/${entry.slug}/`;
const published = pubDate.toISOString().split('T')[0];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: published,
  author: {
    '@type': 'Organization',
    name: 'DesertRich Domains',
    url: 'https://desertrich.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'DesertRich Domains',
    url: 'https://desertrich.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  keywords: tags.join(', '),
};
---

<Layout
  title={`${title} | ABQ.Construction`}
  description={description}
  canonical={canonical}
  structuredData={articleSchema}
>
  <Header />

  <main class="flex-1">
    <article class="section-padding bg-white">
      <div class="container-narrow max-w-3xl">
        <nav class="mb-8 text-sm text-steel-500" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-rust-700">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/insights/" class="hover:text-rust-700">Insights</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-steel-800" aria-current="page">{title}</li>
          </ol>
        </nav>

        <header class="border-b border-steel-200 pb-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-rust-600">Domain Insight</p>
          <h1 class="mt-3 font-display text-4xl font-semibold uppercase tracking-wide text-steel-950 sm:text-5xl">
            {title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-steel-600">{description}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-steel-500">
            <time datetime={published}>
              {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {tags.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li class="rounded-md bg-steel-100 px-2.5 py-1 text-xs font-medium uppercase tracking-wide text-steel-700">
                    {tag}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </header>

        <div class="prose prose-steel mt-10 max-w-none prose-headings:font-display prose-headings:uppercase prose-headings:tracking-wide prose-a:text-rust-700">
          <Content />
        </div>

        <div class="mt-12 rounded-xl border border-steel-200 bg-steel-50 p-6 sm:p-8">
          <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-steel-950">
            Looking at ABQ.Construction?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-steel-600">
            Exact-match city + category domains are scarce. If this brand fit matters for your Albuquerque construction business, inquire while it is still available.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="/#acquisition" class="btn-primary">View acquisition details</a>
            <a href="/insights/" class="btn-secondary">More insights</a>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
