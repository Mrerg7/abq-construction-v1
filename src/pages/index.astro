---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const STREAM_SRC =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/3a86d81e27e77958499dbb2856e6273c/iframe?muted=true&loop=true&autoplay=true&poster=https%3A%2F%2Fcustomer-wa9cpywo3l4jte5c.cloudflarestream.com%2F3a86d81e27e77958499dbb2856e6273c%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600&controls=false';
---

<Layout>
  <Header />

  <main class="flex-1">
    <section class="relative overflow-hidden bg-steel-950">
      <div class="absolute inset-0">
        <div class="relative h-full w-full" style="padding-top: 54.32098765432099%;">
          <iframe
            src={STREAM_SRC}
            title="ABQ.Construction project footage"
            loading="lazy"
            class="absolute inset-0 h-full w-full border-0"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-steel-950 via-steel-950/45 to-steel-950/20"></div>
      </div>

      <div class="relative container-narrow flex min-h-[28rem] items-end pb-12 pt-28 sm:min-h-[34rem] sm:pb-16 lg:min-h-[40rem]">
        <div class="max-w-3xl">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-rust-300">
            Albuquerque · Build · Develop · Deliver
          </p>
          <h1 class="font-display text-5xl font-semibold uppercase tracking-wide text-white sm:text-6xl lg:text-7xl">
            ABQ<span class="text-rust-400">.Construction</span>
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-steel-200 sm:text-lg">
            A category-defining domain for builders working the Albuquerque metro — residential, commercial, and high-desert work that has to last.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#capabilities" class="btn-primary">See Capabilities</a>
            <a href="#acquisition" class="btn-secondary border-steel-500 bg-transparent text-white hover:bg-white/10">Domain Available</a>
          </div>
        </div>
      </div>
    </section>

    <section id="capabilities" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <h2 class="font-display text-4xl font-semibold uppercase tracking-wide text-steel-950">Capabilities</h2>
          <p class="mt-4 text-lg text-steel-600">
            A construction brand in Albuquerque has to cover more than a jobsite. It has to signal reliability in a market defined by climate, codes, and schedule pressure.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-steel-950">Residential</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-600">
              Custom homes, additions, and remodels that handle large daily temperature swings, low humidity, and intense sun.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-steel-950">Commercial</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-600">
              Tenant improvements, ground-up builds, and light industrial work across the Albuquerque and Rio Rancho corridor.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-2xl font-semibold uppercase tracking-wide text-steel-950">Site & Shell</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-600">
              Grading, drainage, and envelope work that account for monsoon storms and high-desert soils.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="climate" class="section-padding bg-steel-50">
      <div class="container-narrow grid items-start gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-4xl font-semibold uppercase tracking-wide text-steel-950">High-desert building</h2>
          <p class="mt-4 text-lg text-steel-600">
            Albuquerque is not a generic Sun Belt market. Elevation, UV, and monsoon weather change how materials perform and how schedules get planned.
          </p>
          <ul class="mt-8 space-y-4 text-steel-700">
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-rust-500"></span>
              <span><strong class="text-steel-950">UV and thermal swing</strong> — finishes and roofing have to tolerate heat by day and cool nights.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-rust-500"></span>
              <span><strong class="text-steel-950">Low humidity</strong> — wood movement, concrete cure, and interior comfort all behave differently here.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-rust-500"></span>
              <span><strong class="text-steel-950">Monsoon drainage</strong> — short, intense storms punish weak site work.</span>
            </li>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-rust-500"></span>
              <span><strong class="text-steel-950">Local codes & inspections</strong> — City of Albuquerque and surrounding jurisdictions reward teams that already know the process.</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-steel-200 bg-white p-8">
          <dl class="space-y-6">
            <div class="flex items-baseline justify-between border-b border-steel-100 pb-4">
              <dt class="text-sm text-steel-500">Market</dt>
              <dd class="font-display text-2xl font-semibold uppercase text-rust-700">Albuquerque MSA</dd>
            </div>
            <div class="flex items-baseline justify-between border-b border-steel-100 pb-4">
              <dt class="text-sm text-steel-500">Elevation</dt>
              <dd class="font-display text-2xl font-semibold uppercase text-rust-700">~5,300 ft</dd>
            </div>
            <div class="flex items-baseline justify-between border-b border-steel-100 pb-4">
              <dt class="text-sm text-steel-500">Climate</dt>
              <dd class="font-display text-2xl font-semibold uppercase text-rust-700">High desert</dd>
            </div>
            <div class="flex items-baseline justify-between">
              <dt class="text-sm text-steel-500">Brand fit</dt>
              <dd class="font-display text-2xl font-semibold uppercase text-rust-700">GC · Builder · Dev</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="brand" class="section-padding bg-white">
      <div class="container-narrow max-w-3xl">
        <h2 class="font-display text-4xl font-semibold uppercase tracking-wide text-steel-950">Why this domain</h2>
        <div class="mt-6 space-y-4 text-steel-700 leading-relaxed">
          <p>
            <strong class="text-steel-950">ABQ.Construction</strong> is the shortest possible pairing of city and category.
            It works on a truck door, a bid cover, and a search result without explanation.
          </p>
          <p>
            The name is available for a general contractor, developer, specialty trade group, or construction-tech brand targeting New Mexico.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-steel-200 bg-steel-50 py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-sm text-steel-500">
          Information presented is for demonstration and educational purposes only and does not constitute an offer of construction services.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
